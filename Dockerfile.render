# Cloud-specific image; the original Dockerfile and docker-compose.yml stay unchanged.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    DEMO_INDEX_DIR=/app/demo-index
WORKDIR /app

COPY requirements-demo.txt ./
RUN pip install --no-cache-dir -r requirements-demo.txt

COPY src/ src/
COPY demo/ demo/
# The demo data is built into the image: no ephemeral volumes or remote downloads.
RUN python demo/build_demo.py --out "$DEMO_INDEX_DIR"

EXPOSE 10000
CMD ["python", "demo/run_cluster.py"]
