# Documentation search variant: separate image, separate branch and optional service.
# Does NOT replace the stable Render portfolio deployment.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src:/app \
    DEMO_INDEX_DIR=/app/docs-index \
    DOCS_METADATA_FILE=/app/docs-index/documents.json
WORKDIR /app
COPY requirements-demo.txt .
RUN pip install --no-cache-dir -r requirements-demo.txt
COPY src/ src/
COPY demo/ demo/
COPY docs_app/ docs_app/
RUN python -m docs_app.build_index --out "$DEMO_INDEX_DIR"
EXPOSE 10000
CMD ["python", "-m", "docs_app.run_cluster"]
